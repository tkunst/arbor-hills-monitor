.DS_Store
.claude/
*.pyc
__pycache__/
.venv/
venv/
node_modules/
*.log

# Secrets / credentials — never commit
.env
.env.*
!.env.example
service-account*.json
*-sa-key.json
gdrive-sa-key.json

# Local working copy of state (canonical copy lives in Google Drive)
egle-n2688-state.json

# Downloaded / OCR'd PDFs — never commit (uploaded to Drive instead)
*.pdf

# Data file types — never commit by default. The data-guard CI check enforces
# this; allowlist legitimate config below if you add it.
*.csv
*.xml
*.json
!package.json
!.markdownlint.json
!.markdownlint.jsonc
# SEO: track the public sitemap despite the *.xml data-file rule above — it is a
# legitimate public site file, not a data file. (data-guard CI only scans files
# newly ADDED in a pull request, so a file committed straight to main is not caught.)
!site/sitemap.xml
# ADR 062 Phase 2: the client-side search index is a legitimate generated public
# site file (same idiom as site/sitemap.xml above), not a data file the *.json
# rule is meant to catch -- without this exception, findings-feed.yml's
# `git add site/public-records` would silently never stage it (git ignores an
# ignored path even when it's inside an added directory), so the file would be
# written on every run but never actually committed/deployed.
!site/public-records/search-index.json
