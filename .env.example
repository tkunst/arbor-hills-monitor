# Copy to .env and fill in. .env is gitignored — never commit real values.
# See scripts/setup_gcp.md for how to obtain each value.

# --- Anthropic (document classification) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Sheets (service account) ---
# Path to the downloaded service-account key JSON (local dev). In GitHub Actions
# this is provided as the GDRIVE_SA_KEY secret (the JSON contents, written to a
# temp file by the workflow). Share the .gsheet with the service-account email
# as Editor; no other credential needed in the repo.
GDRIVE_SA_KEY=./gdrive-sa-key.json
# The Google Sheet ID (the .gsheet case file). From the sheet's URL.
GSHEET_ID=your-sheet-id-here
# Optional: a SEPARATE, PRIVATE Sheet (shared only with the service account, never
# the operator) holding the "Upcoming" tab for the Sunday digest's upcoming-
# activities section. If unset, the digest simply omits that section. See
# upcoming.py + docs/decisions/027.
GSHEET_ID_PRIVATE=your-private-sheet-id-here
# GDRIVE_FOLDER_ID is no longer used (ADR 006: state + links live in the Sheet,
# not a Drive folder). Safe to omit.

# --- Email alerts (SMTP, not Gmail MCP — MCP is interactive-only) ---
# Gmail: enable 2FA -> generate an App Password -> use smtp.gmail.com:587 (TLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@example.com
SMTP_PASSWORD=your-app-password-here
# Optional: extra alert_recipients addresses NOT committed to config.yml (this is
# a PUBLIC repo). Comma/semicolon-separated. Use this for any recipient whose
# public association with the monitor you don't want visible in the repo (e.g.
# an advocacy-org contact) — see email_alerts.resolve_recipients().
ALERT_RECIPIENTS_EXTRA=
# Same idea, scoped to the gfl_air CH4 WATCH-tier list (config.yml's
# gfl_air.watch_alert_recipients) — see email_alerts.merge_extra_recipients().
GFL_AIR_WATCH_RECIPIENTS_EXTRA=
# Same idea again, but scoped to the WEEKLY DIGEST ONLY — never added to the
# same-day [URGENT] send. Use this for a recipient you want easing into the
# record calmly (e.g. a commissioner) before adding them to urgent/perimeter-
# methane alerts. See email_alerts.send_digest() + SUSPENSE.md.
DIGEST_RECIPIENTS_EXTRA=

# --- Optional: durable PDF mirror (OAuth-as-user, ADR 007) ---
# Only needed for the archiver. scripts/oauth_setup.py mints all four. Leave
# unset to disable archiving (archiver.py becomes a no-op). drive.file scope.
GOAUTH_CLIENT_ID=your-oauth-client-id
GOAUTH_CLIENT_SECRET=your-oauth-client-secret
GOAUTH_REFRESH_TOKEN=your-oauth-refresh-token
GOAUTH_ARCHIVE_FOLDER_ID=the-mirror-folder-id
